                    {
                        "activity": "Execute_Gold_Pipeline",
                        "dependencyConditions": [
                            "Succeeded",
                            "Skipped",
                            "Failed"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "storedProcedureName": "[control].[sp_LogMasterPipeline]",
                    "storedProcedureParameters": {
                        "PipelineRunId": {
                            "value": {
                                "value": "@pipeline().RunId",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "Status": {
                            "value": "COMPLETED",
                            "type": "String"
                        }
                    }
                },
                "linkedServiceName": {
                    "referenceName": "LS_AzureSQL_Control",
                    "type": "LinkedServiceReference"
                }
            }
        ],
        "parameters": {
            "pipeline_run_id": {
                "type": "string",
                "defaultValue": "@pipeline().RunId"
            },
            "run_bronze": {
                "type": "bool",
                "defaultValue": true
            },
            "run_silver": {
                "type": "bool",
                "defaultValue": true
            },
            "run_gold": {
                "type": "bool",
                "defaultValue": true
            }
        },
        "annotations": []
    }
