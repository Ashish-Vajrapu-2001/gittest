{
    "name": "PL_Medallion_Master",
    "properties": {
        "activities": [
            {
                "name": "Execute_Bronze_Pipeline",
                "type": "IfCondition",
                "dependsOn": [],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@equals(pipeline().parameters.run_bronze, true)",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "Run_Bronze",
                            "type": "ExecutePipeline",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "PL_Bronze_Orchestrator",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true
                            }
                        }
                    ]
                }
            },
            {
                "name": "Execute_Silver_Pipeline",
                "type": "IfCondition",
